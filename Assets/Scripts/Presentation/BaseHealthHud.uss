.health-container {
    position: absolute;
    top: 10px;
    left: 10px;
    flex-direction: column;
    padding: 5px;
}

.health-label {
    font-size: 18px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.health-bar-background {
    width: 200px;
    height: 20px;
    background-color: rgba(50, 50, 50, 0.8);
    border-radius: 3px;
}

.health-bar-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(50, 200, 50);
    border-radius: 3px;
}

.coin-container {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 5px;
}

.coin-label {
    font-size: 18px;
    color: rgb(255, 215, 0);
    -unity-font-style: bold;
}

.turret-selection-container {
    position: absolute;
    bottom: 10px;
    left: 10px;
    flex-direction: column;
    padding: 5px;
}

.turret-selection-label {
    font-size: 16px;
    color: white;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.turret-option {
    padding: 4px 8px;
    margin-bottom: 2px;
    border-radius: 3px;
    background-color: rgba(50, 50, 50, 0.6);
}

.turret-option--selected {
    background-color: rgba(80, 160, 255, 0.7);
}

.turret-option-label {
    font-size: 14px;
    color: white;
}

.restart-hint-container {
    position: absolute;
    bottom: 40%;
    left: 0;
    right: 0;
    align-items: center;
    display: none;
}

.restart-hint-label {
    font-size: 24px;
    color: white;
    -unity-font-style: bold;
    padding: 8px 16px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 4px;
}
